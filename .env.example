# Model provider for the WEB chat loop only.
# The MCP path (Cursor) uses Cursor's own model — no key needed there.
#
# Set ONE of these. Anthropic is preferred when both are present.
# Copy this file to .env and fill in a key.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides:
# WORK_AGENT_MODEL=claude-sonnet-5
# WORK_AGENT_OPENAI_MODEL=gpt-4o
# WORK_AGENT_MAX_STEPS=8
# WORK_AGENT_READ_ONLY=1
